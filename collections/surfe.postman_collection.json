{
  "info": {
    "name": "Surfe API",
    "description": "B2B people and company search plus enrichment. Verified emails and mobile phone numbers, company firmographics, and lookalike recommendations. Bearer API key auth against https://api.surfe.com/v2. Formerly Leadjet.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.surfe.com/v2",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "People",
      "item": [
        {
          "name": "Search people.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/people/search",
              "host": ["{{baseUrl}}"],
              "path": ["people", "search"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limit\": 10,\n  \"people\": {\n    \"jobTitles\": [\"Head of Sales\"],\n    \"seniorities\": [\"Director\"]\n  },\n  \"companies\": {\n    \"industries\": [\"Software\"],\n    \"countries\": [\"US\"]\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Search for people by persona and company filters. Job titles are expanded automatically with acronym and semantic matching."
          },
          "response": []
        },
        {
          "name": "Enrich people (start).",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/people/enrich",
              "host": ["{{baseUrl}}"],
              "path": ["people", "enrich"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"people\": [\n    {\n      \"linkedinUrl\": \"https://www.linkedin.com/in/example\"\n    }\n  ],\n  \"include\": {\n    \"email\": true,\n    \"mobile\": true,\n    \"linkedInUrl\": true,\n    \"jobHistory\": false\n  },\n  \"enrichmentOptions\": {\n    \"acceptedEmailType\": \"professional\",\n    \"skipMobileEnrichmentIfNoEmailFound\": true\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Start an asynchronous bulk enrichment job for up to 10,000 people. Returns an enrichmentID for polling or webhook callback."
          },
          "response": []
        },
        {
          "name": "Enrich people (get).",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/people/enrich/:id",
              "host": ["{{baseUrl}}"],
              "path": ["people", "enrich", ":id"],
              "variable": [
                { "key": "id", "value": "", "description": "The enrichment job ID returned by the start operation." }
              ]
            },
            "description": "Retrieve the status and results of a people enrichment job by ID."
          },
          "response": []
        },
        {
          "name": "Find people by email.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/people/find-by-email",
              "host": ["{{baseUrl}}"],
              "path": ["people", "find-by-email"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emails\": [\"jane.doe@example.com\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Enrich people directly from a list of email addresses."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Companies",
      "item": [
        {
          "name": "Search companies.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/companies/search",
              "host": ["{{baseUrl}}"],
              "path": ["companies", "search"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limit\": 25,\n  \"filters\": {\n    \"industries\": [\"Software\"],\n    \"employeeCount\": {\n      \"from\": 50,\n      \"to\": 500\n    },\n    \"countries\": [\"US\"]\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Search for companies against Ideal Customer Profile filters. Deducts ceil(results / 25) ICP search credits when credit charging is enabled."
          },
          "response": []
        },
        {
          "name": "Enrich companies (start).",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/companies/enrich",
              "host": ["{{baseUrl}}"],
              "path": ["companies", "enrich"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companies\": [\n    {\n      \"domain\": \"example.com\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Start an asynchronous bulk enrichment job for companies identified by domain."
          },
          "response": []
        },
        {
          "name": "Enrich companies (get).",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/companies/enrich/:id",
              "host": ["{{baseUrl}}"],
              "path": ["companies", "enrich", ":id"],
              "variable": [
                { "key": "id", "value": "", "description": "The enrichment job ID returned by the start operation." }
              ]
            },
            "description": "Retrieve the status and results of a company enrichment job by ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Recommendations",
      "item": [
        {
          "name": "Create or update ICP.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/recommendations/icp",
              "host": ["{{baseUrl}}"],
              "path": ["recommendations", "icp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mid-market SaaS\",\n  \"filters\": {\n    \"industries\": [\"Software\"],\n    \"employeeCount\": {\n      \"from\": 50,\n      \"to\": 1000\n    }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Create or update the Ideal Customer Profile used to generate lookalike account recommendations."
          },
          "response": []
        },
        {
          "name": "Fetch lookalike recommendations.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/recommendations/fetch",
              "host": ["{{baseUrl}}"],
              "path": ["recommendations", "fetch"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limit\": 25\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Fetch lookalike account recommendations resembling the best-fit companies defined by the ICP."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Account",
      "item": [
        {
          "name": "Get credit balance.",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/credits",
              "host": ["{{baseUrl}}"],
              "path": ["credits"]
            },
            "description": "Return the remaining credit balance across the email, mobile, and search/ICP credit pools."
          },
          "response": []
        }
      ]
    }
  ]
}
